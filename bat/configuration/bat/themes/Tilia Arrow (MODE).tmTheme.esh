<%
entry() {
    key="$1"
    colour="$2"
    get="${3:-get-colour}"

    cat <<XML
                <key>$key</key>
                <string>$(tilia $get "$colour")</string>
XML
}

scope() {
    scope="$1"
    colour="$2"

    cat <<XML
        <dict>
            <key>scope</key>
            <string>$scope</string>
            <key>settings</key>
            <dict>
$(              entry foreground "$colour"                                 )
$(              entry background "$colour" "get-background --level primary")
            </dict>
        </dict>
XML
}
-%>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>name</key>
    <string>Tilia Arrow (<%= $TILIA_MODE %>)</string>
    <key>author</key>
    <string>SLUCHABLUB</string>
    <key>colorSpaceName</key>
    <string>sRGB</string>
    <key>settings</key>
    <array>
        <dict>
            <key>settings</key>
            <dict>
<%              entry background primary-background -%>
<%              entry foreground text               -%>
<%              entry caret border                  -%>
<%              entry lineHighlight hover           -%>
<%              entry selection selection           -%>
<%              entry gutter secondary-background   -%>
<%              entry gutterForeground unimportant  -%>
<%              entry invisibles disabled           -%>
            </dict>
        </dict>

<%      scope 'punctuation, meta.brace, meta.delimiter, keyword.operator' unimportant                                                                                                                             -%>
<%      scope 'comment' yellow                                                                                                                                                                                    -%>
<%      scope 'string' green                                                                                                                                                                                      -%>
<%      scope 'constant.numeric, constant.language, constant.other, support.constant' blue                                                                                                                        -%>
<%      scope 'entity.name.function, support.function, meta.function-call, variable.function, entity.name.macro, support.macro' cyan                                                                              -%>
<%      scope 'entity.name.type, entity.name.class, entity.name.struct, entity.name.enum, entity.name.union, entity.name.trait, entity.name.interface, entity.name.namespace, support.type, support.class' purple -%>
<%      scope 'keyword, storage.type, storage.modifier, constant.character.escape' orange                                                                                                                         -%>
    </array>
</dict>
</plist>
