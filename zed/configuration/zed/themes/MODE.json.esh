<%
colour() {
    tilia get-colour "$1" | tr -d '\n'
}

background() {
    tilia get-background --level primary "$1" | tr -d '\n'
}
-%>
{
    "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
    "name": "Tilia Arrow (<%= $TILIA_MODE %>)",
    "author": "SLUCHABLUB",
    "themes": [
        {
            "appearance": "<%= $TILIA_MODE %>",
            "name": "Tilia Arrow (<%= $TILIA_MODE %>)",
            "style": {
                "background": "<% colour primary-background %>",
                "border": "<% colour border %>",
                "border.disabled": "<% colour border %>",
                "border.focused": "<% colour purple %>",
                "border.selected": "<% colour purple %>",
                "border.transparent": "transparent",
                "border.variant": "<% colour border %>",
                "conflict": "<% colour red %>",
                "conflict.background": "<% background red %>",
                "conflict.border": "<% colour border %>",
                "created": "<% colour green %>",
                "created.background": "<% background green %>",
                "created.border": "<% colour border %>",
                "deleted": "<% colour red %>",
                "deleted.background": "<% background red %>",
                "deleted.border": "<% colour border %>",
                "drop_target.background": "<% colour hover %>",
                "editor.active_line.background": "<% colour hover %>",
                "editor.active_line_number": "<% colour text %>",
                "editor.active_wrap_guide": "<% colour unimportant %>",
                "editor.background": "<% colour primary-background %>",
                "editor.document_highlight.bracket_background": "<% colour selection %>",
                "editor.document_highlight.read_background": "<% background green %>",
                "editor.document_highlight.write_background": "<% background orange %>",
                "editor.foreground": "<% colour text %>",
                "editor.gutter.background": "<% colour secondary-background %>",
                "editor.highlighted_line.background": "<% colour hover %>",
                "editor.indent_guide": "<% colour border %>",
                "editor.indent_guide_active": "<% colour border %>",
                "editor.invisible": "<% colour disabled %>",
                "editor.line_number": "<% colour unimportant %>",
                // I'm unsure what this does.
                "editor.subheader.background": null,
                "editor.wrap_guide": "<% colour disabled %>",
                // These are background colours.
                "element.active": "<% colour secondary-background %>",
                "element.background": "<% colour secondary-background %>",
                "element.disabled": "<% colour secondary-background %>",
                "element.hover": "<% colour hover %>",
                "element.selected": "<% colour selection %>",
                "error": "<% colour red %>",
                "error.background": "<% background red %>",
                "error.border": "<% colour red %>",
                "ghost_element.active": null,
                "ghost_element.background": null,
                "ghost_element.disabled": null,
                "ghost_element.hover": "<% colour hover %>",
                "ghost_element.selected": "<% colour selection %>",
                "hidden": "<% colour unimportant %>",
                "hidden.background": null,
                "hidden.border": null,
                "hint": "<% colour cyan %>",
                "hint.background": "<% background cyan %>",
                "hint.border": "<% colour border %>",
                "icon": "<% colour text %>",
                "icon.accent": "<% colour purple %>",
                "icon.disabled": "<% colour disabled %>",
                "icon.muted": "<% colour unimportant %>",
                "icon.placeholder": "<% colour disabled %>",
                "ignored": "<% colour unimportant %>",
                "ignored.background": null,
                "ignored.border": null,
                "info": "<% colour cyan %>",
                "info.background": "<% background cyan %>",
                "info.border": "<% colour border %>",
                "modified": "<% colour orange %>",
                "modified.background": "<% background orange %>",
                "modified.border": "<% colour border %>",
                // I'm unsure what this does.
                "pane.focused_border": "<% colour purple %>",
                "pane_group.border": "<% colour border %>",
                "panel.background": "<% colour tertiary-background %>",
                "panel.focused_border": "<% colour purple %>",
                "panel.indent_guide": "<% colour border %>",
                "panel.indent_guide_active": "<% colour border %>",
                "panel.indent_guide_hover": "<% colour border %>",
                // I'm unsure what this does.
                "predictive": "<% colour blue %>",
                "predictive.background": "<% background blue %>",
                "predictive.border": "<% colour border %>",
                "renamed": "<% colour orange %>",
                "renamed.background": "<% background orange %>",
                "renamed.border": "<% colour border %>",
                "scrollbar.thumb.background": "transparent",
                "scrollbar.thumb.border": "<% colour text %>",
                "scrollbar.thumb.hover_background": "<% colour hover %>",
                "scrollbar.track.background": "<% colour secondary-background %>",
                "scrollbar.track.border": "<% colour border %>",
                "search.match_background": "<% colour yellow %>",
                "success": "<% colour green %>",
                "success.background": "<% background green %>",
                "success.border": "<% colour border %>",
                "surface.background": "<% colour secondary-background %>",
                // TODO: tab
                "tab_bar.background": "<% colour primary-background %>",
                // TODO: terminal
                "text": "<% colour text %>",
                "text.accent": "<% colour purple %>",
                "text.disabled": "<% colour disabled %>",
                "text.muted": "<% colour unimportant %>",
                "text.placeholder": "<% colour disabled %>",
                "title_bar.background": "<% colour secondary-background %>",
                "title_bar.inactive_background": "<% colour secondary-background %>",
                "toolbar.background": "<% colour secondary-background %>",
                "unreachable": "<% colour disabled %>",
                "unreachable.background": "<% colour primary-background %>",
                "unreachable.border": "<% colour border %>",
                "warning": "<% colour yellow %>",
                "warning.background": "<% background yellow %>",
                "warning.border": "<% colour border %>",
                "players": [
                    {
                        "background": "<% colour primary-background %>",
                        "cursor": "<% colour border %>",
                        "selection": "<% colour selection %>"
                    }
                ],
                "syntax": {
                    // TODO: attribute
                    "boolean": {
                        "color": "<% colour orange %>",
                        "background_color": "<% background orange %>"
                    },
                    // TODO: constant
                    // TODO: constructor
                    "comment": {
                        "color": "<% colour yellow %>",
                        "background_color": "<% background yellow %>"
                    },
                    "comment.doc": {
                        "color": "<% colour unimportant %>"
                    },
                    // TODO: embedded
                    "emphasis": {
                        "font_weight": 700
                    },
                    "emphasis.strong": {
                        "font_style": "italic"
                    },
                    // TODO: enum
                    "function": {
                        "color": "<% colour blue %>",
                        "background_color": "<% background blue %>"
                    },
                    // TODO: hint
                    "keyword": {
                        "color": "<% colour orange %>",
                        "background_color": "<% background orange %>"
                    },
                    // TODO: label
                    // TODO: link text
                    // TODO: link uri
                    // TODO: namespace
                    "number": {
                        "color": "<% colour cyan %>",
                        "background_color": "<% background cyan %>"
                    },
                    "operator": {
                        "color": "<% colour unimportant %>"
                    },
                    // TODO: predictive
                    "preproc": {
                        "color": "<% colour cyan %>",
                        "background_color": "<% background cyan %>"
                    },
                    // TODO: primary
                    // TODO: property
                    "punctuation": {
                        "color": "<% colour unimportant %>"
                    },
                    // TODO: punctuation.special?
                    // TODO: selector
                    // TODO: selector.pseudo
                    "string": {
                        "color": "<% colour green %>",
                        "background_color": "<% background green %>"
                    },
                    "string.escape": {
                        "color": "<% colour orange %>",
                        "background_color": "<% background orange %>"
                    },
                    // TODO: string.regex
                    // TODO: string.special
                    // TODO: string.special.symbol
                    // TODO: tag
                    // TODO: title
                    "type": {
                        "color": "<% colour purple %>",
                        "background_color": "<% background purple %>"
                    },
                    "variable": {}
                    // TODO: variable.special
                    // TODO: variant
                }
            }
        }
    ]
}
