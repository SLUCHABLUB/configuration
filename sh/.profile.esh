#!/bin/sh

# These are the XDG directories from when this file was built,
# falling back to the defaults from the XDG Base Directory Specification.
export XDG_CACHE_HOME="<%= "${XDG_CACHE_HOME:-$HOME/.cache}" %>"
export XDG_CONFIG_HOME="<%= "${XDG_CONFIG_HOME:-$HOME/.config}" %>"
export XDG_DATA_HOME="<%= "${XDG_DATA_HOME:-$HOME/.local/share}" %>"
export XDG_STATE_HOME="<%= "${XDG_STATE_HOME:-$HOME/.local/state}" %>"
# Not part of the XDG Base Directory Specification but respected by some programs.
export XDG_BIN_HOME="<%= "${XDG_BIN_HOME:-$HOME/.local/bin}" %>"

export PATH="$XDG_BIN_HOME:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"

if command -v browse >/dev/null
then
    export BROWSER="browse"
fi

export EDITOR="textadept-curses"
export PAGER="bat --style header-filename"

# Make 'roff' emit plain text so bat can do the highlighting.
export MANROFFOPT="-P-cbou"
export MANPAGER="bat --plain --language man"
