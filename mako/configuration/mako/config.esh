<%
colour() {
    tilia get-colour "$1"
}

segment() {
    cat <<INI
[mode=$TILIA_MODE]
background-color=$(colour tertiary-background)
text-color=$(      colour text               )
border-color=$(    colour border             )

[urgency=critical mode=$TILIA_MODE]
border-color=$(colour red)
INI
}
-%>
font=JetBrains Mono NerdFont
border-size=2
border-radius=6

<% TILIA_MODE=light segment -%>

<% TILIA_MODE=dark  segment -%>
