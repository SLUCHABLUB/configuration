<%
foreground() {
    tilia get-colour "$1" "0xbbggrr" | tr -d '\n'
}

background() {
    tilia get-background --level primary "$1" "0xbbggrr" | tr -d '\n'
}
-%>
-- Tilia Arrow (<%= $TILIA_MODE %>) theme for Textadept.

local view, styles = view, view.styles

local primary_background   = "<% foreground primary-background   %>"
local secondary_background = "<% foreground secondary-background %>"
local hover                = "<% foreground hover                %>"
local selection            = "<% foreground selection            %>"
local border               = "<% foreground border               %>"
local disabled             = "<% foreground disabled             %>"
local unimportant          = "<% foreground unimportant          %>"
local text                 = "<% foreground text                 %>"

local red    = { fore = "<% foreground red    %>", back = "<% background red    %>" }
local orange = { fore = "<% foreground orange %>", back = "<% background orange %>" }
local yellow = { fore = "<% foreground yellow %>", back = "<% background yellow %>" }
local green  = { fore = "<% foreground green  %>", back = "<% background green  %>" }
local cyan   = { fore = "<% foreground cyan   %>", back = "<% background cyan   %>" }
local blue   = { fore = "<% foreground blue   %>", back = "<% background blue   %>" }
local purple = { fore = "<% foreground purple %>", back = "<% background purple %>" }

-- Predefined styles.
styles[view.STYLE_DEFAULT] = { fore = text, back = primary_background }
styles[view.STYLE_LINENUMBER] = { fore = unimportant, back = secondary_background }
styles[view.STYLE_BRACELIGHT] = { back = selection }
styles[view.STYLE_BRACEBAD] = red
styles[view.STYLE_INDENTGUIDE] = { fore = border }
styles[view.STYLE_CALLTIP] = { fore = unimportant, back = secondary_background }
styles[view.STYLE_FOLDDISPLAYTEXT] = { fore = unimportant, back = secondary_background }

-- Tag styles.
-- Tags not listed here use the default style (miscellaneous tokens).
styles[lexer.BOLD] = { bold = true }
styles[lexer.CLASS] = purple
styles[lexer.COMMENT] = yellow
styles[lexer.CONSTANT_BUILTIN] = cyan
styles[lexer.ERROR] = red
styles[lexer.FUNCTION] = blue
styles[lexer.FUNCTION_BUILTIN] = blue
styles[lexer.FUNCTION_METHOD] = blue
styles[lexer.HEADING] = { bold = true }
styles[lexer.KEYWORD] = orange
styles[lexer.LINK] = { underline = true }
styles[lexer.NUMBER] = cyan
styles[lexer.OPERATOR] = { fore = unimportant }
styles[lexer.PREPROCESSOR] = blue
styles[lexer.REFERENCE] = { underline = true }
styles[lexer.REGEX] = green
styles[lexer.STRING] = green
styles[lexer.TYPE] = purple
styles[lexer.UNDERLINE] = { underline = true }

-- Diff.
styles.addition = green
styles.deletion = red
styles.change = orange
-- Output.
styles.csi = { visible = false }

-- Element colours.
view.element_color[view.ELEMENT_SELECTION_BACK] = selection
view.element_color[view.ELEMENT_SELECTION_ADDITIONAL_BACK] = selection
view.element_color[view.ELEMENT_CARET_LINE_BACK] = hover
view.element_color[view.ELEMENT_WHITE_SPACE] = disabled

-- Markers.
view.marker_back[textadept.bookmarks.MARK_BOOKMARK] = purple.fore
view.marker_back[textadept.run.MARK_WARNING] = yellow.fore
view.marker_back[textadept.run.MARK_ERROR] = red.fore

-- Indicators.
view.indic_fore[ui.find.INDIC_FIND] = yellow.fore
view.indic_fore[textadept.editing.INDIC_HIGHLIGHT] = selection
view.indic_fore[textadept.snippets.INDIC_PLACEHOLDER] = purple.fore
view.indic_fore[textadept.run.INDIC_WARNING] = yellow.fore
view.indic_fore[textadept.run.INDIC_ERROR] = red.fore

-- Call tips.
view.call_tip_fore_hlt = purple.fore

-- Long lines.
view.edge_color = border
