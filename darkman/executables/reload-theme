#!/usr/bin/env bash

data="${XDG_DATA_HOME:-$HOME/.local/share}"

mode="${1:-$(darkman get)}"

# Darkman reports "null" before it knows the mode.
case "$mode" in
dark | light) ;;
*)
    echo "Refusing to switch to unknown mode '$mode'" >&2
    exit 1
    ;;
esac

echo "Switching to $mode mode"

failed=()
for hook in "$data/theme-hooks"/*
do
    if [ -x "$hook" ] && ! "$hook" "$mode"
    then
        failed+=("$(basename -- "$hook")")
    fi
done

if [ "${#failed[@]}" -gt 0 ]
then
    printf -v list '%s, ' "${failed[@]}"
    message="These hooks failed: ${list%, }"

    echo "$message" >&2
    notify-send --app-name=reload-theme --urgency=critical \
        "Switching to $mode mode failed" "$message"
    exit 1
fi
