#!/bin/sh

data="${XDG_DATA_HOME:-$HOME/.local/share}"

mode="${1:-$(darkman get)}"

# Darkman reports "null" before it knows the mode.
case "$mode" in
dark | light) ;;
*)
    echo "Refusing to switch to unknown mode '$mode'" >&2
    exit 1
    ;;
esac

echo "Switching to $mode mode"

# Run the same hooks darkman runs when the mode changes.
status=0
for hook in "$data/darkman"/*
do
    if [ -x "$hook" ] && ! "$hook" "$mode"
    then
        echo "The hook '$hook' failed" >&2
        status=1
    fi
done

exit "$status"
