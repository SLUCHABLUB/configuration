#!/bin/sh

data="${XDG_DATA_HOME:-$HOME/.local/share}"

wallpapers="$data/wallpapers/$(darkman get)"
wallpaper="$(find -L "$wallpapers" -type f -print | shuf -n 1)"
current="$data/wallpapers/current"

ln -sf "$wallpaper" "$current"

killall swaybg
niri msg action spawn -- swaybg --image "$current" --mode fill
