<%
colour() {
    tilia get-colour "$1" | tr -d '\n'
}
-%>
@define-color primary-background    <% colour primary-background   %>;
@define-color secondary-background  <% colour secondary-background %>;
@define-color tertiary-background   <% colour tertiary-background  %>;

@define-color hover                 <% colour hover                %>;
@define-color selection             <% colour selection            %>;
@define-color border                <% colour border               %>;

@define-color disabled              <% colour disabled             %>;
@define-color unimportant           <% colour unimportant          %>;
@define-color text                  <% colour text                 %>;

@define-color red                   <% colour red                  %>;
@define-color orange                <% colour orange               %>;
@define-color yellow                <% colour yellow               %>;
@define-color green                 <% colour green                %>;
@define-color cyan                  <% colour cyan                 %>;
@define-color blue                  <% colour blue                 %>;
@define-color purple                <% colour purple               %>;
