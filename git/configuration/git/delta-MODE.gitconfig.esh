<%
colour() {
    colour="$1"
    background="${2-}"

    tilia get-colour "$colour" | tr -d '\n'

    if [ -n "$background" ]
    then
        printf ' '
        tilia get-background --level primary "$colour" | tr -d '\n'
    fi
}
-%>
[delta]
    <%= $TILIA_MODE %> = true
    syntax-theme = Tilia Arrow (<%= $TILIA_MODE %>)

    line-numbers-minus-style = "<% colour red         with-background %>"
    line-numbers-plus-style  = "<% colour green       with-background %>"
    line-numbers-zero-style  = "<% colour unimportant                 %>"
    line-numbers-left-style  = "<% colour unimportant                 %>"
    line-numbers-right-style = "<% colour unimportant                 %>"

    file-style            = "<% colour text   %>"
    file-decoration-style = "<% colour border %>"

    commit-style            = "<% colour text   %>"
    commit-decoration-style = "<% colour border %>"

    merge-conflict-ours-diff-header-style   = "<% colour orange with-background %>"
    merge-conflict-theirs-diff-header-style = "<% colour orange with-background %>"

    whitespace-error-style = "<% colour red %>"
