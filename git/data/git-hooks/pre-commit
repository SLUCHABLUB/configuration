#!/usr/bin/env bash

set -euo pipefail

exec 1>&2

stashed=false

# shellcheck disable=SC2329 # False positive, it's passed to `trap`.
restore() {
    if [ "$stashed" = true ]
    then
        # set working tree & index -> HEAD
        git reset --hard --quiet
        # move stash -> working tree & index
        git stash pop --index --quiet
    fi
}

if ! git diff --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]
then
    # move working tree -> stash
    # set index -> working tree
    git stash push --keep-index --include-untracked --quiet
    stashed=true
    trap restore EXIT
fi

if [ -f "Cargo.toml" ]
then
    export RUSTDOCFLAGS="-D warnings"

    cargo +nightly fmt    --all       --check
    cargo          clippy --workspace -- --deny warnings
    cargo          test   --workspace
    cargo          doc    --workspace
fi

if [ -f "gradlew" ]
then
    ./gradlew check
fi

# Checks if a file has a shell extension or shebang
is_shell_script() {
    file="$1"

    if [ -L "$file" ] || [ ! -f "$file" ]
    then
        return 1
    fi

    case "$file" in
    *.sh | *.bash | *.dash | *.ksh)
        return 0
        ;;
    esac

    head -n 1 -- "$file" | grep --quiet --extended-regexp '^#!\s*\S*/(env\s+)?(ba|da|k)?sh(\s|$)'
}

shell_scripts=()

while IFS= read -r -d '' file
do
    if is_shell_script "$file"
    then
        shell_scripts+=("$file")
    fi
done < <(git ls-files -z)

if [ "${#shell_scripts[@]}" -gt 0 ]
then
    shellcheck -- "${shell_scripts[@]}"
fi

codebook-lsp lint -su .

local_hook="$(git rev-parse --git-dir)/hooks/pre-commit"

if [ -x "$local_hook" ]
then
    exec "$local_hook" "$@"
fi
