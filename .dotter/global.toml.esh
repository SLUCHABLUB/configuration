<%
# Each package lists the commands it needs under [package.variables.commands],
# keyed by its own name so the tables merge without clashing.
# The pre-deploy hook refuses to deploy while any of them is missing.

# Resolve the deployment locations from the XDG variables,
# falling back to the defaults from the XDG Base Directory Specification.
config="${XDG_CONFIG_HOME:-$HOME/.config}"
data="${XDG_DATA_HOME:-$HOME/.local/share}"
# XDG_BIN_HOME is not part of the specification but is commonly used.
executables="${XDG_BIN_HOME:-$HOME/.local/bin}"
-%>
[settings]
# Never guess that a file is a handlebars template.
default_target_type = "symbolic"

[bash]
depends = ["sh"]

[bash.files]
"bash/.bashrc" = "~/.bashrc"
"bash/.bash_login" = "~/.bash_login"

[bash.variables.commands]
bash = ["bash", "starship"]

[bat.files]
"bat/configuration/bat/config" = "<%= "$config" %>/bat/config"
"bat/configuration/bat/themes/Tilia Arrow (dark).tmTheme" = "<%= "$config" %>/bat/themes/Tilia Arrow (dark).tmTheme"
"bat/configuration/bat/themes/Tilia Arrow (light).tmTheme" = "<%= "$config" %>/bat/themes/Tilia Arrow (light).tmTheme"

[bat.variables.commands]
bat = ["bat", "moor"]

[blesh.files]
"blesh/configuration/blesh" = "<%= "$config" %>/blesh"

[btop.files]
"btop/configuration/btop" = "<%= "$config" %>/btop"

[btop.variables.commands]
btop = ["btop"]

[codebook.files]
"codebook/configuration/codebook" = "<%= "$config" %>/codebook"

[codebook.variables.commands]
codebook = ["codebook-lsp"]

[darkman]
depends = ["wallpapers"]

[darkman.files]
"darkman/configuration/darkman" = "<%= "$config" %>/darkman"
"darkman/executables/reload-theme" = "<%= "$executables" %>/reload-theme"
"darkman/executables/switch-wallpaper" = "<%= "$executables" %>/switch-wallpaper"
"darkman/data/darkman" = "<%= "$data" %>/darkman"

[darkman.variables.commands]
darkman = [
    "darkman",
    "killall",
    "kitten",
    "kreadconfig6",
    "kwriteconfig6",
    "makoctl",
    "niri",
    "plasma-apply-colorscheme",
    "shuf",
    "swaybg",
]

[fastfetch.files]
"fastfetch/configuration/fastfetch" = "<%= "$config" %>/fastfetch"

[fastfetch.variables.commands]
fastfetch = ["fastfetch"]

[fonts.files]
"fonts/configuration/fontconfig/fonts.conf" = "<%= "$config" %>/fontconfig/fonts.conf"

[fuzzel]
depends = ["darkman"]

[fuzzel.files]
"fuzzel/configuration/fuzzel/dark.ini" = "<%= "$config" %>/fuzzel/dark.ini"
"fuzzel/configuration/fuzzel/light.ini" = "<%= "$config" %>/fuzzel/light.ini"

[fuzzel.variables.commands]
fuzzel = ["fuzzel"]

[git]
depends = ["darkman"]

[git.files]
"git/configuration/git/paths.gitconfig" = "<%= "$config" %>/git/paths.gitconfig"
"git/configuration/git/config" = "<%= "$config" %>/git/config"
"git/configuration/git/ignore" = "<%= "$config" %>/git/ignore"
"git/configuration/git/delta-dark.gitconfig" = "<%= "$config" %>/git/delta-dark.gitconfig"
"git/configuration/git/delta-light.gitconfig" = "<%= "$config" %>/git/delta-light.gitconfig"
"git/data/git-hooks" = "<%= "$data" %>/git-hooks"

[git.variables.commands]
git = ["git", "delta", "codebook-lsp"]

[helium.files]
"helium/configuration/helium-browser-flags.conf" = "<%= "$config" %>/helium-browser-flags.conf"
"helium/executables/browse" = "<%= "$executables" %>/browse"

[helium.variables.commands]
helium = ["helium-browser"]

[kde.files]
"kde/data/color-schemes/Tilia (dark).colors" = "<%= "$data" %>/color-schemes/Tilia (dark).colors"
"kde/data/color-schemes/Tilia (light).colors" = "<%= "$data" %>/color-schemes/Tilia (light).colors"

[kitty]
depends = ["darkman"]

[kitty.files]
"kitty/configuration/kitty/kitty.conf" = "<%= "$config" %>/kitty/kitty.conf"
"kitty/configuration/kitty/themes/dark.conf" = "<%= "$config" %>/kitty/themes/dark.conf"
"kitty/configuration/kitty/themes/light.conf" = "<%= "$config" %>/kitty/themes/light.conf"

[kitty.variables.commands]
kitty = ["kitty", "moor"]

[mako.files]
"mako/configuration/mako/config" = "<%= "$config" %>/mako/config"

[mako.variables.commands]
mako = ["mako"]

[micro]
depends = ["darkman"]

[micro.files]
"micro/configuration/micro/bindings.json" = "<%= "$config" %>/micro/bindings.json"
"micro/configuration/micro/settings.json" = "<%= "$config" %>/micro/settings.json"
"micro/configuration/micro/syntax" = "<%= "$config" %>/micro/syntax"
"micro/configuration/micro/colorschemes/dark.micro" = "<%= "$config" %>/micro/colorschemes/dark.micro"
"micro/configuration/micro/colorschemes/light.micro" = "<%= "$config" %>/micro/colorschemes/light.micro"

[micro.variables.commands]
micro = ["micro"]

[niri]
depends = ["darkman", "swaylock"]

[niri.files]
"niri/configuration/niri/config.kdl" = "<%= "$config" %>/niri/config.kdl"
"niri/configuration/niri/dark.kdl" = "<%= "$config" %>/niri/dark.kdl"
"niri/configuration/niri/light.kdl" = "<%= "$config" %>/niri/light.kdl"
"niri/executables/spawn" = "<%= "$executables" %>/spawn"

[niri.variables.commands]
niri = [
    "niri",
    "brightnessctl",
    "dbus-update-activation-environment",
    "kwalletd6",
    "playerctl",
    "wpctl",
    "/usr/lib/polkit-kde-authentication-agent-1",
]

[portal.files]
"portal/configuration/xdg-desktop-portal" = "<%= "$config" %>/xdg-desktop-portal"

[sh.files]
"sh/.profile" = "~/.profile"

[sh.variables.commands]
sh = ["bat", "textadept-curses"]

[shellcheck.files]
"shellcheck/.shellcheckrc" = "~/.shellcheckrc"

[shellcheck.variables.commands]
shellcheck = ["shellcheck"]

[starship.files]
"starship/configuration/starship.toml" = "<%= "$config" %>/starship.toml"

[starship.variables.commands]
starship = ["starship"]

[status.files]
"status/executables/status" = "<%= "$executables" %>/status"

[status.variables.commands]
status = ["bash", "git"]

[swayidle]
depends = ["swaylock"]

[swayidle.files]
"swayidle/configuration/swayidle" = "<%= "$config" %>/swayidle"

[swayidle.variables.commands]
swayidle = ["swayidle", "niri"]

[swaylock]
depends = ["darkman"]

[swaylock.files]
"swaylock/configuration/swaylock/dark" = "<%= "$config" %>/swaylock/dark"
"swaylock/configuration/swaylock/light" = "<%= "$config" %>/swaylock/light"
"swaylock/executables/lock" = "<%= "$executables" %>/lock"

[swaylock.variables.commands]
swaylock = ["swaylock"]

[textadept]
depends = ["kitty"]

[textadept.files]
"textadept/.textadept/init.lua" = "~/.textadept/init.lua"
"textadept/.textadept/lexers" = "~/.textadept/lexers"
"textadept/.textadept/modules" = "~/.textadept/modules"
"textadept/.textadept/themes/tilia-arrow-dark.lua" = "~/.textadept/themes/tilia-arrow-dark.lua"
"textadept/.textadept/themes/tilia-arrow-light.lua" = "~/.textadept/themes/tilia-arrow-light.lua"

[textadept.variables.commands]
textadept = ["textadept-curses", "codebook-lsp", "kitten"]

[wallpapers.files]
"wallpapers/data/wallpapers" = "<%= "$data" %>/wallpapers"

[waybar]
depends = ["darkman"]

[waybar.files]
"waybar/configuration/waybar/config.jsonc" = "<%= "$config" %>/waybar/config.jsonc"
"waybar/configuration/waybar/style.css" = "<%= "$config" %>/waybar/style.css"
"waybar/configuration/waybar/dark.css" = "<%= "$config" %>/waybar/dark.css"
"waybar/configuration/waybar/light.css" = "<%= "$config" %>/waybar/light.css"

[waybar.variables.commands]
waybar = ["waybar", "brightnessctl", "wpctl"]

[xdg.files]
"xdg/configuration/environment.d/10-xdg-directories.conf" = "<%= "$config" %>/environment.d/10-xdg-directories.conf"

[yazi.files]
"yazi/configuration/yazi" = "<%= "$config" %>/yazi"

[yazi.variables.commands]
yazi = ["yazi"]

[zed.files]
"zed/configuration/zed/keymap.json" = "<%= "$config" %>/zed/keymap.json"
"zed/configuration/zed/settings.json" = "<%= "$config" %>/zed/settings.json"
"zed/configuration/zed/themes/dark.json" = "<%= "$config" %>/zed/themes/dark.json"
"zed/configuration/zed/themes/light.json" = "<%= "$config" %>/zed/themes/light.json"

[zed.variables.commands]
zed = ["zeditor"]
