#!/bin/sh

data="${XDG_DATA_HOME:-$HOME/.local/share}"
mode="${1:-$(darkman get)}"

wallpapers="$data/wallpapers/$mode"
wallpaper="$(find -L "$wallpapers" -type f -print | shuf -n 1)"
current="$data/wallpapers/current"

ln -sf "$wallpaper" "$current"

killall swaybg
spawn swaybg --image "$current" --mode fill
