include optional=true "theme.kdl"
// The displays of this machine, deployed by its host package.
include optional=true "outputs.kdl"
include "binds.kdl"
include "startup.kdl"
include "window-rules.kdl"

input {
    focus-follows-mouse

    keyboard {
        xkb {
            layout "se"
        }
    }

    touchpad {
        natural-scroll
        accel-profile "flat"
        click-method "clickfinger"
    }

    mouse {
        natural-scroll
        accel-profile "flat"
    }
}

gestures {
    hot-corners {
        off
    }
}

prefer-no-csd

layout {
    center-focused-column "never"

    default-column-width { proportion 1.0; }

    focus-ring {
        off
    }
}

environment {
    ELECTRON_OZONE_PLATFORM_HINT "auto"

    QT_QPA_PLATFORMTHEME "kde"
}

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/%Y-%m-%d %H-%M-%S.png"
