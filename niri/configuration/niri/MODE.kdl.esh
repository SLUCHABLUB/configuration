<%
colour() {
    tilia get-colour "$1" | tr -d '\n'
}
-%>
layout {
    gaps 6

    border {
        on

        width 2

        active-color   "<% colour purple %>"
        inactive-color "<% colour border %>"
        urgent-color   "<% colour red    %>"
    }
}

window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}
