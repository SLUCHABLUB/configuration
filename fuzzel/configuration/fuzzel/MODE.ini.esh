<%
colour() {
    tilia get-colour "$1" rrggbbaa
}
-%>
font=JetBrainsMono Nerd Font Mono
hide-before-typing=yes
minimal-lines=yes
launch-prefix=spawn

[border]
width=2
radius=6

[colors]
background=<%      colour tertiary-background -%>
text=<%            colour text                -%>
prompt=<%          colour unimportant         -%>
placeholder=<%     colour unimportant         -%>
input=<%           colour text                -%>
match=<%           colour purple              -%>
selection=<%       colour selection           -%>
selection-text=<%  colour text                -%>
selection-match=<% colour purple              -%>
border=<%          colour purple              -%>
