<%
colour() {
    tilia get-colour "$1" rrggbbaa | tr -d '\n'
}
-%>
font=JetBrainsMono Nerd Font

scaling=fill
color=<% colour primary-background %>

effect-blur=20x10
fade-in=0.2

show-failed-attempts

indicator-radius=60
indicator-thickness=2
indicator-idle-visible

clock
timestr=%H:%M
datestr=%a %e %b

line-uses-ring
separator-color=00000000

inside-color=<% colour tertiary-background %>
ring-color=<%   colour border              %>
text-color=<%   colour text                %>
key-hl-color=<% colour purple              %>
bs-hl-color=<%  colour red                 %>

# clear
inside-clear-color=< colour tertiary-background %>
ring-clear-color=<   colour border              %>
text-clear-color=<   colour text                %>

# verifying
inside-ver-color=<% colour tertiary-background %>
ring-ver-color=<%   colour purple              %>
text-ver-color=<%   colour text                %>

# wrong
inside-wrong-color=<% colour tertiary-background %>
ring-wrong-color=<%   colour red                 %>
text-wrong-color=<%   colour text                %>

# caps lock
inside-caps-lock-color=<%  colour tertiary-background %>
ring-caps-lock-color=<%    colour yellow              %>
text-caps-lock-color=<%    colour text                %>
caps-lock-bs-hl-color=<%   colour red                 %>
caps-lock-key-hl-color=<%  colour yellow              %>

# layout text box
layout-bg-color=<%     colour tertiary-background %>
layout-border-color=<% colour border              %>
layout-text-color=<%   colour text                %>
