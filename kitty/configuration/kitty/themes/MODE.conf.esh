<%
colour() {
    tilia get-colour "$1"
}
-%>
## name: Tilia (<%= $TILIA_MODE %>)
## author: SLUCHABLUB
## license: GPL-3.0-or-later
## upstream: https://github.com/SLUCHABLUB/configuration/blob/main/kitty/configuration/kitty/themes/<%= $TILIA_MODE %>.conf
## blurb:

foreground <% colour text               -%>
background <% colour primary-background -%>

selection_foreground <% colour text      -%>
selection_background <% colour selection -%>

cursor            <% tilia get-colour border -%>
cursor_text_color <% tilia get-colour text   -%>

url_color <% colour blue -%>

active_tab_foreground   <% colour text                -%>
active_tab_background   <% colour tertiary-background -%>
inactive_tab_foreground <% colour disabled            -%>
inactive_tab_background <% colour primary-background  -%>

# "Black" through "White".
color0  <% colour primary-background -%>
color8  <% colour disabled           -%>
color7  <% colour unimportant        -%>
color15 <% colour text               -%>

# Red.
color1  <% colour red    -%>
color9  <% colour red    -%>

# Green.
color2  <% colour green  -%>
color10 <% colour green  -%>

# Yellow (or orange for dark yellow).
color3  <% colour orange -%>
color11 <% colour yellow -%>

# Blue.
color4  <% colour blue   -%>
color12 <% colour blue   -%>

# Purple.
color5  <% colour purple -%>
color13 <% colour purple -%>

# Cyan.
color6  <% colour cyan   -%>
color14 <% colour cyan   -%>
